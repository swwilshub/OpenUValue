{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openuvalue.org/schema/material.schema.json",
  "title": "OpenUValue material database",
  "type": "object",
  "required": ["schemaVersion", "materials"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material" }
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "lambdaWPerMK",
        "densityKgPerM3",
        "specificHeatCapacityJPerKgK",
        "vapourResistanceFactorMu",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "masonry",
            "concrete",
            "timber-and-board",
            "insulation",
            "plaster-and-render",
            "screed",
            "membrane",
            "covering"
          ]
        },
        "lambdaWPerMK": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Design thermal conductivity, W/(m*K)"
        },
        "densityKgPerM3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Density, kg/m^3"
        },
        "specificHeatCapacityJPerKgK": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Specific heat capacity, J/(kg*K)"
        },
        "vapourResistanceFactorMu": {
          "type": "number",
          "minimum": 1,
          "description": "Water vapour resistance factor mu; 1 is the value for air, and no material can be below it"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "A standard table reference, or the literal string TODO(verify)"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
