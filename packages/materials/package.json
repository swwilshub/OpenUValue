{
  "name": "@openuvalue/materials",
  "version": "0.1.0",
  "description": "Generic UK building material database with schema validation. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
